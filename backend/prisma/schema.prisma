// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemRole {
  SUPER_ADMIN   // ShipLink platform admin — full access, all companies
  COMPANY_ADMIN // Full access to their own company — can manage roles
  COMPANY_STAFF // Access determined entirely by their assigned dynamic Role
  AGENT         // Verification + assigned customers only
  CUSTOMER      // Own shipments, payments, contracts only
}

enum CompanyStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────────────────────

// Dynamic role created by company admin or staff with roles:manage permission
model Role {
  id          String           @id @default(uuid())
  name        String
  description String?
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name, companyId])
  @@map("roles")
}

// One row per resource granted to a role
model RolePermission {
  id       String   @id @default(uuid())
  roleId   String
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  actions  String[]

  @@unique([roleId, resource])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid())
  systemRole   SystemRole
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  password     String
  isActive     Boolean    @default(true)
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id])
  roleId       String?    // assigned dynamic Role — only for COMPANY_STAFF
  role         Role?      @relation(fields: [roleId], references: [id])
  agent        Agent?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

model Company {
  id           String            @id @default(uuid())
  name         String           @unique
  subdomain    String            @unique
  customDomain String?           @unique
  status       CompanyStatus     @default(PENDING)
  email        String?
  phone        String?
  address      String?
  logoUrl      String?
  users        User[]
  agents       Agent[]
  roles        Role[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("companies")
}

model Agent {
  id                   String                @id @default(uuid())
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id])
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  region               String
  city                 String
  profession           String?
  referralCode         String                @unique
  gpsCoordinates       String?
  trustScore           Float                 @default(5.0)
  verificationStatus   VerificationStatus    @default(PENDING)
  isAvailable          Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("agents")
}
