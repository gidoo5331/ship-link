# ShipLink API base URL, including /api/v1 (built into the app at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Company website for "View website". {subdomain} is replaced with the company's subdomain.
# Until subdomains are live, point it at the deployed site, e.g. https://ship-link-rho.vercel.app
NEXT_PUBLIC_WEBSITE_URL=https://{subdomain}.shiplink.com
