# ── Content editing (Keystatic, at /keystatic) ─────────────────────────────
# local  = edits save to the files in this folder (development, the default)
# cloud  = editors sign in with Keystatic Cloud; saves commit to GitHub (deployed site)
# github = editors sign in with GitHub; saves commit to GitHub (deployed site)
NEXT_PUBLIC_KEYSTATIC_STORAGE=local

# cloud mode: the project from keystatic.cloud, e.g. my-team/ship-link
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# github mode: the repo, plus the values Keystatic generates when you run /keystatic
# once in github mode locally (it creates a GitHub App and prints these)
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=gidoo5331/ship-link
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ── Interest and contact forms ─────────────────────────────────────────────
NEXT_PUBLIC_FORMSPREE_URL=
